# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only)
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI or Admin Settings.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VEHICLE_LOOKUP_API_KEY: Authorized VAHAN / vehicle verification API key (server-side only)
VEHICLE_LOOKUP_API_KEY=""

# VEHICLE_LOOKUP_API_URL: Endpoint for authorized vehicle verification provider
VEHICLE_LOOKUP_API_URL=""

# VEHICLE_LOOKUP_PROVIDER: Provider name identifier (e.g. "signzy", "surepass", "karza", "sandbox")
VEHICLE_LOOKUP_PROVIDER=""

# VEHICLE_LOOKUP_TIMEOUT_MS: Maximum timeout for external API requests (default: 8000)
VEHICLE_LOOKUP_TIMEOUT_MS="8000"

# =============================================================
# ULTRON SMS GATEWAY CONFIGURATION (DLT-APPROVED TELECOM GATEWAY)
# =============================================================
SMS_BASE_URL="https://ultronsms.com/api/mt/SendSMS"
SMS_PE_ID="1701177943584895129"
SMS_USER=""
SMS_PASSWORD=""
SMS_DLT_TEMPLATE_ID="1707178132876719605"
SMS_CHANNEL="Trans"
SMS_SENDER_ID="TRSSET"
SMS_ROUTE="02"

# Cloud SQL Connection Variables (injected by AI Studio environment)
SQL_HOST=""
SQL_DB_NAME=""
SQL_USER=""
SQL_PASSWORD=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""
