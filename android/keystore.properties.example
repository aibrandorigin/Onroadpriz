# Owner-Controlled Android Upload Key Configuration (DO NOT COMMIT ACTUAL keystore.properties)
# Copy this file to android/keystore.properties and supply your private upload keystore path and credentials,
# or pass RELEASE_STORE_FILE, RELEASE_STORE_PASSWORD, RELEASE_KEY_ALIAS, RELEASE_KEY_PASSWORD via environment variables.
storeFile=upload-keystore.jks
storePassword=YOUR_PRIVATE_STORE_PASSWORD
keyAlias=onroadpriz-upload
keyPassword=YOUR_PRIVATE_KEY_PASSWORD
